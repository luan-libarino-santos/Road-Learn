# Copie para .env e ajuste os valores.
# Nunca versionar o arquivo .env.

SECRET_KEY=altere-para-uma-chave-secreta-forte
DEBUG=True
# * evita 400 na Oracle (IP público ≠ IP da VNIC). Restrinja se quiser.
ALLOWED_HOSTS=*
ALLOW_ANY_HOST=True
DATABASE_URL=sqlite:///db.sqlite3

# Chave para os outros módulos do hub (Authorization: Bearer ...)
ROADLEARN_API_KEY=altere-esta-chave

# Gemini — geração de roadmap e projetos via IA
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Links do hub na sidebar (vazios escondem o atalho)
HUB_DINHEIRO_URL=http://150.230.230.89:8000
HUB_TREINOS_URL=http://150.230.230.89:3001
HUB_TASKS_URL=http://150.230.230.89:8001

# Origem do browser no IP público (porta 8002). Sem isso o CSRF bloqueia POST.
CSRF_TRUSTED_ORIGINS=http://150.230.230.89:8002,http://150.230.230.89,http://127.0.0.1:8002,http://localhost:5173
